<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon />
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BicoherenceAnalyzer\BicoherenceAnalyzer.csproj" />
    <ProjectReference Include="..\WebView2Plots\WebView2Plots.csproj" />
    <PackageReference Include="ScottPlot.WinForms" Version="4.1.68" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SeeSharpTools.JY.Graph3D">
      <HintPath>lib\SeeSharpTools.JY.Graph3D.dll</HintPath>
    </Reference>
    <Reference Include="SeeSharpTools.JY.File">
      <HintPath>lib\SeeSharpTools.JY.File.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\WebView2Plots\threeDSurfaceWeb.html">
      <Link>threeDSurfaceWeb.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
